APP_NAME=Finlia
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Colombia: español, COP y hora de Bogotá (CLAUDE.md §1).
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO
APP_TIMEZONE=America/Bogota

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Finlia corre sobre MySQL/MariaDB o PostgreSQL, en local y en producción
# (ADR-0036). SQLite se usa SOLO para la suite de tests, que lo configura
# por su cuenta en phpunit.xml — no lo pongas aquí.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=finlia
DB_USERNAME=root
DB_PASSWORD=

# …o PostgreSQL: basta cambiar el driver y el puerto.
# DB_CONNECTION=pgsql
# DB_PORT=5432

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# En producción (HTTPS) pon SESSION_SECURE_COOKIE=true.
SESSION_SECURE_COOKIE=false

# Drivers compatibles con hosting compartido: nada que exija un proceso
# permanente (docs/DEPLOYMENT.md §6). Las colas se procesan por cron.
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Correo transaccional (ADR-0015) y digest de recordatorios (ADR-0028).
#
# `log` es el valor de desarrollo: los correos van a storage/logs y la app
# funciona igual — la invitación se comparte con el enlace manual y el
# digest ni siquiera corre. En producción, SMTP (ver docs/DEPLOYMENT.md §4).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-responder@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Interruptor global del correo: en false no sale ni una invitación ni un
# digest, sin tocar código.
FINLIA_MAIL_ENABLED=true

# Mercado y moneda. El diseño no se acopla a un solo país (CLAUDE.md §1).
FINLIA_MARKET=CO
FINLIA_CURRENCY_CODE=COP
FINLIA_CURRENCY_SYMBOL=$

VITE_APP_NAME="${APP_NAME}"
